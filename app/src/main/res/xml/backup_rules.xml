<?xml version="1.0" encoding="utf-8"?>
<!--
   Clear speichert alles nur auf dem Handy. Nichts wird in die Cloud gesichert
   (gilt fuer Android 11 und aelter, siehe data_extraction_rules.xml fuer Android 12+).
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
